# ===== 基础 =====
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
# 对外 API Key（逗号分隔多个）
RELAY_API_KEYS=sk-your-key-1,sk-your-key-2
# 管理台 Basic Auth（/api/* 与 /web/* 保护）
RELAY_ADMIN_USER=admin
RELAY_ADMIN_PASSWORD=change-me

# ===== WorkBuddy Provider（本仓库新增） =====
WB_PROVIDER_ENABLED=1
WB_MODEL_PREFIX=wb-
WB_IDE_VERSION=5.8.3
# 上游（默认即可，无需修改）
# WB_UPSTREAM_CHAT=https://copilot.tencent.com/v2/chat/completions
# WB_PLUGIN_BASE=https://www.codebuddy.cn/v2/plugin
# WB_METER_BASE=https://www.codebuddy.cn/v2/billing/meter
